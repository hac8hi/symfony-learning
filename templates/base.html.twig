<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Symfony Learning{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        <style>
            body { font-family: system-ui, sans-serif; max-width: 720px; margin: 0 auto; padding: 0 16px; color: #222; }
            nav { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid #ddd; margin-bottom: 24px; }
            nav a { margin-left: 12px; }
            form { display: flex; flex-direction: column; gap: 12px; max-width: 360px; }
            input { padding: 8px; font-size: 1rem; }
            button { padding: 10px; font-size: 1rem; cursor: pointer; }
            .error { background: #fde8e8; color: #9b1c1c; padding: 8px 12px; border-radius: 4px; }
            .success { background: #e6f6ec; color: #1e6b3a; padding: 8px 12px; border-radius: 4px; }
            table { width: 100%; border-collapse: collapse; }
            th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; }
        </style>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <nav>
            <a href="{{ path('app_home') }}"><strong>Symfony Learning</strong></a>
            <div>Tasks assigned to me: {{ my_task_count() }}</div>
            <div>
                {% if app.user %}
                    {{ app.user.userIdentifier }}
                    <a href="{{ path('app_logout') }}">Log out</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Log in</a>
                    <a href="{{ path('app_register') }}">Register</a>
                {% endif %}
            </div>
        </nav>

        {% for message in app.flashes('success') %}
            <p class="success">{{ message }}</p>
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>
