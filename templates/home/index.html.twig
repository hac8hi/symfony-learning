{% extends 'base.html.twig' %}

{% block title %}Projects{% endblock %}

{% block body %}
    <a href="/project/new">Nouveau Projet</a>
    <h1>Projects</h1>

    <table>
        <thead>
            <tr>
                <th>Key</th>
                <th>Name</th>
                <th>Description</th>
                <th>Owner</th>
                <th>Tasks</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for project in projects %}
                <tr>
                    <td>{{ project.keyProject }}</td>
                    <td>{{ project.name }}</td>
                    <td>{{ project.description }}</td>
                    <td>{{ project.user.userIdentifier }}</td>
                    <td>{{ project.tasks|length }}</td>
                    <td><a href="{{ path('app_project_edit', {id: project.id}) }}">Edit</a></td>
                </tr>
            {% else %}
                <tr><td colspan="5">No projects yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <h2>Tasks</h2>

    <table>
        <thead>
            <tr>
                <th>Key</th>
                <th>Title</th>
                <th>Project</th>
                <th>Assignee</th>
            </tr>
        </thead>
        <tbody>
            {% for task in tasks %}
                <tr>
                    <td>{{ task.keyTask }}</td>
                    <td>
                        {{ task.title }}<br>
                        <small>{{ task.description }}</small>
                    </td>
                    <td>{{ task.project.name }}</td>
                    <td>{{ task.user.userIdentifier }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4">No tasks yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
